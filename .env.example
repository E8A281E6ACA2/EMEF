# Credentials and endpoints must be supplied locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Reference configuration for running the released extraction code.
OPENAI_MAX_TOKENS=16384
OPENAI_TEMPERATURE=0.5
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=600
EXTRACTION_MAX_TOKENS=16384
EXTRACTION_TEMPERATURE=0.5

LLM_RETRY_MAX=5
LLM_RETRY_BASE_DELAY=2
LLM_RETRY_JITTER=0.3
LLM_STREAM=1
LLM_STREAM_STDOUT=0

EXTRACTION_PROMPT_LANG=cn
EXTRACTION_CHUNK_MAX_CHARS=0
EXTRACTION_CHUNK_OVERLAP_CHARS=0
SCHEMA_VALIDATE=0
SCHEMA_RETRY_MAX=1

# Graph writes are disabled unless both credentials and NEO4J_WRITE are set.
NEO4J_WRITE=0
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
